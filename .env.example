# Copy to .env (gitignored, chalkignored) and fill in real values.
# `Secret.from_local_env_file(".env")` in chalkcompute_agent_demo.py reads these
# at deploy time and uploads them to Chalk's secret store.

# Hugging Face token — needed by chalkcompute_vllm_server.py to pull
# Qwen2.5-7B-Instruct weights from the HF Hub. Read-access scope is fine.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_REPLACE_ME

# vLLM server URL — populated by running ./chalkcompute_vllm_server.py once.
# The agent function reads this at runtime to talk to the self-hosted model.
VLLM_URL=https://qwen-vllm-server.REPLACE_ME

# Chalk environment credentials — needed so ChalkClient inside the agent can
# query the feature store. Values come from `chalk config`.
CHALK_API_SERVER=https://api.staging.chalk.ai
CHALK_CLIENT_ID=client-REPLACE_ME
CHALK_CLIENT_SECRET=secret-REPLACE_ME
CHALK_ENVIRONMENT_ID=REPLACE_ME
